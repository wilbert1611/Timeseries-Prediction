   "source": [
    "#### Selanjutnya saya akan melakukan splitting data berdasarkan window sizenya, dengan proporsi 80% data train, 10% data validation, dan 10% data test."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "d31d0fb2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(40320, 21) (5040, 21) (5040, 21)\n"
     ]
    }
   ],
   "source": [
    "n = len(df)\n",
    "df_train = df.iloc[:int(0.8 * n)].copy()\n",
    "df_val = df.iloc[int(0.8 * n) - 0: int(0.9 * n)].copy()\n",
    "df_test = df.iloc[int(0.9 * n) - 0:].copy()\n",
    "\n",
    "print(df_train.shape, df_val.shape, df_test.shape)"
   ]
  },
